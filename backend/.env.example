# Server
PORT=4000
NODE_ENV=development

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/certiflow?schema=public

# Local React + Vite frontend (CORS allowlist)
FRONTEND_URL=http://localhost:3000

# JWT signing secret (use a long random value in real environments)
JWT_SECRET=change-me-to-a-long-random-secret

# Google Gemini API key (for future AI-assisted features)
GEMINI_API_KEY=

# Redis (caching / job queues — used in later phases)
REDIS_URL=redis://localhost:6379
